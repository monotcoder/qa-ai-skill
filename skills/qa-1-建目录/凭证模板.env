# bug 平台的凭证，只放在你自己电脑上
#
# 怎么用：找到你们用的那个平台，把等号后面填上，其余的空着不用管。
#
# 三条规矩：
# 1. 不要发给任何人，也不要发给 AI
# 2. AI 不打开这个文件。脚本运行的时候自己读，AI 只知道变量名，不知道值
# 3. 凭证建的时候权限越小越好：只给那一个项目，只给"读"或"建单、改单"，不给删除，不用管理员账号建
#
# 不知道某一项去哪拿：跟 AI 说「教我拿 XX 平台的凭证」，它会查官方文档一步步带你
# 想断开：去平台上把这个凭证作废，AI 就再也连不上了

# ---------- 飞书多维表格 ----------
# 去 https://open.feishu.cn/app（国际版 Lark 是 https://open.larksuite.com/app）建一个"企业自建应用"
# App ID 和 App Secret 在应用的"凭证与基础信息"里
# 别忘了：在表格右上角"…"→"添加文档应用"，把这个应用加进去，给"可编辑"
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 表格的链接，直接从浏览器地址栏复制（这个不是机密）
FEISHU_BITABLE_URL=

# ---------- Jira ----------
# 云版地址形如 https://你们公司.atlassian.net
# 云版的令牌在 https://id.atlassian.com/manage-profile/security/api-tokens 建
# 公司自己部署的 Jira，在个人设置里建"个人访问令牌"，这时 JIRA_EMAIL 留空
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# 项目代号，就是单号前面那几个字母，比如 TJT-123 的 TJT
JIRA_PROJECT_KEY=

# ---------- 禅道 ----------
# 禅道的接口要用账号登录换令牌，所以这里要填账号和密码：
# 请管理员建一个专门给 AI 用的账号，只给提 bug 的权限，不要填你自己的账号
ZENTAO_URL=
ZENTAO_ACCOUNT=
ZENTAO_PASSWORD=
# 产品编号：在禅道里打开那个产品，地址栏里的数字
ZENTAO_PRODUCT_ID=

# ---------- TAPD ----------
# 公司管理员在"公司管理 → API 账号管理"里建 API 账号和口令
TAPD_API_USER=
TAPD_API_PASSWORD=
# 项目编号：打开项目，地址栏 tapd.cn/ 后面那串数字
TAPD_WORKSPACE_ID=

# ---------- GitLab ----------
# 在"用户设置 → 访问令牌"建，或者在项目的"设置 → 访问令牌"建（只对这个项目有效，更安全）
# 权限勾 api
GITLAB_URL=
GITLAB_TOKEN=
# 项目编号：项目首页名字下面那个 Project ID
GITLAB_PROJECT_ID=

# ---------- GitHub ----------
# 在 Settings → Developer settings → Fine-grained tokens 建
# 只选这一个仓库，权限只给 Issues 的 Read and write
GITHUB_TOKEN=
# 仓库，形如 你的用户名/仓库名
GITHUB_REPO=

# ---------- 别的平台 ----------
# 在下面照着加，变量名用大写英文，跟 AI 说一声变量名就行
